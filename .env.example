# Copier ce fichier en ".env", puis exécuter : node ace generate:key
# Ne jamais publier le fichier .env (il est exclu de Git).

TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
SESSION_DRIVER=cookie

# Base de données PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=trafic
DB_PASSWORD=
DB_DATABASE=trafic_abidjan
# Intelligence artificielle (Groq) — https://console.groq.com/keys
# Clé SECRÈTE : ne jamais la publier ni l'envoyer à quelqu'un.
# Sans clé, l'application utilise automatiquement le mécanisme de repli.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Délai maximal d'attente de la réponse de l'IA (millisecondes)
GROQ_TIMEOUT_MS=8000
# json_schema (sortie structurée stricte) ou json_object (mode JSON simple)
GROQ_RESPONSE_FORMAT=json_schema
# Plafond applicatif : nombre maximal d'estimations par jour
GROQ_DAILY_LIMIT=200
# true = ne jamais appeler l'IA (démonstration du repli)
PREDICTION_FORCE_FALLBACK=false

# Google Maps Platform — clé NAVIGATEUR (visible dans la page : la restreindre
# dans Google Cloud au site http://localhost:3333/* et aux API Maps JavaScript
# et Places API (New)). Sans clé, le formulaire reste en saisie manuelle.
GOOGLE_MAPS_BROWSER_KEY=
# Identifiant de carte (marqueurs). DEMO_MAP_ID convient pour les tests locaux.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Google Routes API — clé SERVEUR (SECRÈTE : jamais dans le navigateur ni sur GitHub).
# Appels réels DÉSACTIVÉS par défaut : ne passer à true qu'avec une autorisation explicite.
GOOGLE_ROUTES_ENABLED=false
GOOGLE_ROUTES_SERVER_KEY=
# Délai maximal de réponse de Google (millisecondes)
GOOGLE_ROUTES_TIMEOUT_MS=8000
# Plafond applicatif : appels réels maximum par jour (compté en base)
GOOGLE_ROUTES_DAILY_LIMIT=50
