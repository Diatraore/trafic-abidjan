# Valeurs utilisées uniquement par "node ace test" (elles complètent le fichier .env).
# Les tests utilisent une base séparée : vos vraies données ne sont jamais touchées.
SESSION_DRIVER=memory
DB_DATABASE=trafic_abidjan_test

# Aucun appel réel à Groq pendant les tests : la clé est volontairement vide.
# Les tests de l'IA utilisent des réponses simulées.
GROQ_API_KEY=
PREDICTION_FORCE_FALLBACK=false

# Pas de carte Google pendant les tests (les tests l'activent avec une fausse clé).
GOOGLE_MAPS_BROWSER_KEY=
