{{-- Badge coloré du niveau de congestion (props : level, label, size) --}}
@let(colors = {
  fluide: 'bg-emerald-100 text-emerald-800 ring-emerald-200',
  modere: 'bg-amber-100 text-amber-800 ring-amber-200',
  dense: 'bg-orange-100 text-orange-800 ring-orange-200',
  bloque: 'bg-red-100 text-red-800 ring-red-200',
})
<span class="inline-flex items-center rounded-full ring-1 font-semibold {{ colors[level] }} {{ size === 'lg' ? 'px-4 py-1.5 text-lg' : 'px-2.5 py-0.5 text-xs' }}">
  {{ label }}
</span>
