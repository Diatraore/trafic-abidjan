@layout({ title: 'Tableau de bord' })
  <h1 class="text-2xl font-semibold">Bonjour {{ auth.user.nom }}</h1>
  <p class="mt-1 text-slate-600">Estimez la congestion d'un déplacement à Abidjan.</p>

  <div class="mt-6 grid gap-6 lg:grid-cols-3">
    {{-- Formulaire de prédiction --}}
    <section class="lg:col-span-2 bg-white rounded-lg border border-slate-200 p-6">
      <h2 class="text-lg font-semibold mb-4">Nouvelle estimation</h2>

      <form id="formulaire-prediction" method="POST" action="{{ route('predictions.store') }}" class="space-y-5" novalidate>
        {{ csrfField() }}

        <div class="grid gap-5 sm:grid-cols-2">
          @each(point in [
            { name: 'depart', label: 'Lieu de départ', placeholder: 'Ex. : Cocody, Riviera 2' },
            { name: 'arrivee', label: "Lieu d'arrivée", placeholder: 'Ex. : Plateau' }
          ])
            <div>
              <label for="{{ point.name }}" class="block text-sm font-medium">{{ point.label }}</label>

              {{-- Recherche Google Places (insérée par resources/js/map.js si la carte est disponible) --}}
              <div data-autocomplete="{{ point.name }}" class="mt-1 hidden"></div>

              {{-- Saisie manuelle : utilisée si Google Maps est indisponible --}}
              <input id="{{ point.name }}" name="{{ point.name }}" type="text"
                value="{{ old(point.name) || '' }}" required minlength="2" maxlength="255"
                placeholder="{{ point.placeholder }}" data-saisie-manuelle
                class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500" />

              {{-- Lieu retenu (affiché lorsque la carte est active) --}}
              <p data-lieu-retenu="{{ point.name }}" class="mt-1 hidden text-xs text-slate-600"></p>

              {{-- Coordonnées : remplies par Google Places ou par un clic sur la carte --}}
              <input type="hidden" name="{{ point.name }}_latitude" value="{{ old(point.name + '_latitude') || '' }}" />
              <input type="hidden" name="{{ point.name }}_longitude" value="{{ old(point.name + '_longitude') || '' }}" />
              @!fieldError({ name: point.name })
              @!fieldError({ name: point.name + '_latitude' })
              @!fieldError({ name: point.name + '_longitude' })
            </div>
          @end

          <div>
            <label for="date_deplacement" class="block text-sm font-medium">Date du déplacement</label>
            <input id="date_deplacement" name="date_deplacement" type="date"
              value="{{ old('date_deplacement') || '' }}" min="{{ minDate }}" required
              class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500" />
            @!fieldError({ name: 'date_deplacement' })
          </div>

          <div>
            <label for="heure_deplacement" class="block text-sm font-medium">Heure du déplacement</label>
            <input id="heure_deplacement" name="heure_deplacement" type="time"
              value="{{ old('heure_deplacement') || '' }}" required
              class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500" />
            @!fieldError({ name: 'heure_deplacement' })
          </div>
        </div>

        @if(maps.enabled)
          {{-- Carte Google Maps (phase A : affichage, recherche et clic ; aucun calcul d'itinéraire) --}}
          <div id="carte-trafic" class="hidden space-y-2"
            data-maps-key="{{ maps.browserKey }}"
            data-map-id="{{ maps.mapId }}"
            data-center-lat="{{ maps.center.lat }}"
            data-center-lng="{{ maps.center.lng }}"
            data-zoom="{{ maps.zoom }}">
            <div class="flex flex-wrap items-center gap-2 text-sm">
              <span class="text-slate-600">Le prochain clic sur la carte définit :</span>
              <button type="button" data-cible="depart" aria-pressed="true"
                class="px-3 py-1 rounded-full border border-slate-300 aria-pressed:bg-emerald-600 aria-pressed:text-white aria-pressed:border-emerald-600">
                A · Départ
              </button>
              <button type="button" data-cible="arrivee" aria-pressed="false"
                class="px-3 py-1 rounded-full border border-slate-300 aria-pressed:bg-emerald-600 aria-pressed:text-white aria-pressed:border-emerald-600">
                B · Arrivée
              </button>
              <button type="button" data-effacer class="ml-auto px-3 py-1 rounded-md text-slate-600 hover:bg-slate-100">
                Effacer les points
              </button>
            </div>
            <div data-carte class="h-80 w-full rounded-md border border-slate-200 bg-slate-100"></div>
          </div>
          <p data-carte-message class="hidden text-sm text-amber-700"></p>
        @end

        <p class="text-xs text-slate-500">
          Heure d'Abidjan (GMT).
          @if(maps.enabled)
            Recherchez un lieu ou cliquez sur la carte. Un point choisi par clic est désigné
            par ses coordonnées GPS (libellé provisoire).
          @else
            Pour l'instant, les lieux sont saisis manuellement : leur position exacte n'est pas
            encore prise en compte.
          @end
        </p>

        <button type="submit"
          class="w-full sm:w-auto px-6 py-2.5 rounded-md bg-emerald-600 text-white font-medium hover:bg-emerald-700">
          Estimer la congestion
        </button>
      </form>
      @if(maps.enabled)
        @vite(['resources/js/map.js'])
      @end
    </section>

    {{-- Dernières estimations --}}
    <section class="bg-white rounded-lg border border-slate-200 p-6">
      <h2 class="text-lg font-semibold mb-4">Mes dernières estimations</h2>
      @if(recentPredictions.length)
        <ul class="divide-y divide-slate-100">
          @each(prediction in recentPredictions)
            <li>
              <a href="{{ route('predictions.show', { id: prediction.id }) }}" class="block py-3 hover:bg-slate-50 -mx-2 px-2 rounded">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-sm font-medium truncate">{{ prediction.departureLabel }} → {{ prediction.arrivalLabel }}</span>
                  @!levelBadge({ level: prediction.congestionLevel, label: prediction.levelLabel })
                </div>
                <span class="text-xs text-slate-500">
                  {{ prediction.departureDatetime.setZone('Africa/Abidjan').setLocale('fr').toFormat("d LLL yyyy 'à' HH'h'mm") }}
                </span>
              </a>
            </li>
          @end
        </ul>
      @else
        <p class="text-sm text-slate-500">Aucune estimation pour le moment.</p>
      @end
    </section>
  </div>
@end
