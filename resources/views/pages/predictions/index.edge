@layout({ title: 'Historique' })
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h1 class="text-2xl font-semibold">Historique de mes estimations</h1>
    @if(estimations.total > 0)
      <p class="text-sm text-slate-500">
        {{ estimations.total }} estimation{{ estimations.total > 1 ? 's' : '' }}
        — page {{ estimations.currentPage }} sur {{ estimations.lastPage }}
      </p>
    @end
  </div>
  <p class="mt-1 text-sm text-slate-600">
    Estimations expérimentales : elles ne constituent pas des mesures du trafic réel.
  </p>

  @if(estimations.total === 0)
    <div class="mt-6 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-slate-600">
      Aucune estimation pour le moment.
      <a href="{{ route('dashboard') }}" class="text-emerald-700 hover:underline">Faire une première estimation</a>.
    </div>
  @elseif(estimations.length === 0)
    <div class="mt-6 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-slate-600">
      Cette page ne contient aucune estimation.
      <a href="{{ estimations.getUrl(1) }}" class="text-emerald-700 hover:underline">Revenir à la première page</a>.
    </div>
  @else
    <div class="mt-6 overflow-x-auto rounded-lg border border-slate-200 bg-white">
      <table class="min-w-full text-sm">
        <thead class="bg-slate-50 text-left text-slate-600">
          <tr>
            <th scope="col" class="px-4 py-3 font-medium">Estimation</th>
            <th scope="col" class="px-4 py-3 font-medium">Trajet</th>
            <th scope="col" class="px-4 py-3 font-medium">Départ prévu (Abidjan)</th>
            <th scope="col" class="px-4 py-3 font-medium">Niveau</th>
            <th scope="col" class="px-4 py-3 font-medium">Méthode</th>
            <th scope="col" class="px-4 py-3 font-medium">Prévision Google</th>
            <th scope="col" class="px-4 py-3"><span class="sr-only">Détail</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          @each(prediction in estimations)
            <tr data-estimation-id="{{ prediction.id }}" class="hover:bg-slate-50">
              <td class="px-4 py-3 whitespace-nowrap text-slate-600">
                n° {{ prediction.id }}<br />
                <span class="text-xs">{{ prediction.createdAt.setZone('Africa/Abidjan').setLocale('fr').toFormat("d LLL yyyy, HH'h'mm") }}</span>
              </td>
              <td class="px-4 py-3 min-w-48">
                {{ prediction.departureLabel }} → {{ prediction.arrivalLabel }}
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                {{ prediction.departureDatetime.setZone('Africa/Abidjan').setLocale('fr').toFormat("ccc d LLL yyyy, HH'h'mm") }}
              </td>
              <td class="px-4 py-3">
                @!levelBadge({ level: prediction.congestionLevel, label: prediction.levelLabel })
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                {{ prediction.predictionSource === 'ia' ? 'IA' : 'Repli' }}
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                @if(prediction.routeStatus === 'ok')
                  obtenue
                  @if(prediction.trafficRatio !== null)
                    <span class="text-xs text-slate-500">(R = {{ prediction.trafficRatio.toFixed(2).replace('.', ',') }})</span>
                  @end
                @else
                  —
                @end
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-right">
                <a href="{{ route('predictions.show', { id: prediction.id }) }}" class="text-emerald-700 hover:underline">
                  Voir le détail
                </a>
              </td>
            </tr>
          @end
        </tbody>
      </table>
    </div>

    @if(estimations.lastPage > 1)
      <nav aria-label="Pagination de l'historique" class="mt-4 flex items-center justify-between text-sm">
        @if(estimations.currentPage > 1)
          <a href="{{ estimations.getUrl(estimations.currentPage - 1) }}" rel="prev"
            class="px-3 py-1.5 rounded-md border border-slate-300 hover:bg-slate-100">← Page précédente</a>
        @else
          <span></span>
        @end
        <span class="text-slate-500">Page {{ estimations.currentPage }} sur {{ estimations.lastPage }}</span>
        @if(estimations.currentPage < estimations.lastPage)
          <a href="{{ estimations.getUrl(estimations.currentPage + 1) }}" rel="next"
            class="px-3 py-1.5 rounded-md border border-slate-300 hover:bg-slate-100">Page suivante →</a>
        @else
          <span></span>
        @end
      </nav>
    @end
  @end
@end
