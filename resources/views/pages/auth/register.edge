@layout({ title: 'Inscription' })
  <div class="max-w-md mx-auto bg-white rounded-lg border border-slate-200 p-6">
    <h1 class="text-2xl font-semibold mb-6">Créer un compte</h1>

    <form method="POST" action="{{ route('register.store') }}" class="space-y-4" novalidate>
      {{ csrfField() }}

      <div>
        <label for="nom" class="block text-sm font-medium">Nom</label>
        <input id="nom" name="nom" type="text" value="{{ old('nom') || '' }}" required maxlength="100"
          class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500" />
        @!fieldError({ name: 'nom' })
      </div>

      <div>
        <label for="email" class="block text-sm font-medium">Email</label>
        <input id="email" name="email" type="email" value="{{ old('email') || '' }}" required
          class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500" />
        @!fieldError({ name: 'email' })
      </div>

      <div>
        <label for="password" class="block text-sm font-medium">Mot de passe (8 caractères minimum)</label>
        <input id="password" name="password" type="password" required minlength="8"
          class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500" />
        @!fieldError({ name: 'password' })
      </div>

      <div>
        <label for="password_confirmation" class="block text-sm font-medium">Confirmer le mot de passe</label>
        <input id="password_confirmation" name="password_confirmation" type="password" required minlength="8"
          class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500" />
      </div>

      <button type="submit" class="w-full py-2.5 rounded-md bg-emerald-600 text-white font-medium hover:bg-emerald-700">
        S'inscrire
      </button>
    </form>

    <p class="mt-4 text-sm text-center text-slate-600">
      Déjà inscrit ? <a href="{{ route('login') }}" class="text-emerald-700 hover:underline">Se connecter</a>
    </p>
  </div>
@end
